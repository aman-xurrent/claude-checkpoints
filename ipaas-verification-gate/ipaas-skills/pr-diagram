#!/usr/bin/env python3
"""Publish one phase diagram and print the markdown for its pull request section.

    .claude/bin/pr-diagram --pr 1027 --name phase-1 \
        --png out/phase-1.png --svg out/phase-1.svg --source out/phase-1.excalidraw

The files go on the branch `review-assets/<pr>-<slug>`, which is never merged. The slug comes from
the branch name unless `--slug` is given. The png is what renders in the description. The svg is the
same drawing, scalable, and its text can be read back: the user answers a diagram by adding `R:IN`,
`R:OUT` or `R:<text>` marks, and `~/personal/scripts/excalidraw-marks` reads them from the svg or
from the source file.

Nothing here touches the pull request branch or main.
"""
import argparse
import base64
import json
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ASSET_PREFIX = "review-assets"
HOST = "git.4me.com"
PNG_SCALE = 3
# A light diagram reads as a wall of white next to a code editor. Dark is the house style, and it is
# checked rather than asked for: the light diagrams this replaced measured 0.82 and 0.94.
MAX_MEAN_BRIGHTNESS = 0.35
VIEWBOX = re.compile(r'viewBox="\s*[-\d.]+\s+[-\d.]+\s+([\d.]+)\s+([\d.]+)\s*"')
SIZE_ATTRIBUTE = re.compile(r'\s(width|height)="[\d.]+(?:px)?"')


def gh(*arguments, stdin=None):
    done = subprocess.run(["gh", *arguments], capture_output=True, text=True, input=stdin,
                          env={**__import__("os").environ, "GH_HOST": HOST})
    if done.returncode != 0:
        raise SystemExit(f"pr-diagram: gh {' '.join(arguments)[:60]} failed: {done.stderr.strip()[:300]}")
    return done.stdout.strip()


def repository():
    url = subprocess.run(["git", "remote", "get-url", "origin"], capture_output=True, text=True).stdout.strip()
    match = re.search(r"[:/]([^/:]+/[^/]+?)(?:\.git)?$", url)
    if not match:
        raise SystemExit("pr-diagram: cannot read the repository from origin")
    return match.group(1)


def branch_slug():
    name = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True).stdout.strip()
    tail = name.split("/")[-1]
    return re.sub(r"[^a-z0-9-]+", "-", tail.lower()).strip("-") or "assets"


def api(path, method=None, payload=None):
    arguments = ["api", path]
    if method:
        arguments += ["-X", method]
    if payload is not None:
        arguments += ["--input", "-"]
    return gh(*arguments, stdin=json.dumps(payload) if payload is not None else None)


def blob(repo, path):
    content = base64.b64encode(Path(path).read_bytes()).decode()
    answer = json.loads(api(f"/repos/{repo}/git/blobs", "POST", {"content": content, "encoding": "base64"}))
    return answer["sha"]


def head_of(repo, branch):
    done = subprocess.run(["gh", "api", f"/repos/{repo}/git/ref/heads/{branch}"], capture_output=True, text=True,
                          env={**__import__("os").environ, "GH_HOST": HOST})
    if done.returncode != 0:
        return None
    return json.loads(done.stdout)["object"]["sha"]


def publish(repo, branch, files, message):
    parent = head_of(repo, branch)
    tree = [{"path": name, "mode": "100644", "type": "blob", "sha": blob(repo, path)} for name, path in files]
    body = {"tree": tree}
    if parent:
        body["base_tree"] = json.loads(api(f"/repos/{repo}/git/commits/{parent}"))["tree"]["sha"]
    tree_sha = json.loads(api(f"/repos/{repo}/git/trees", "POST", body))["sha"]
    commit = {"message": message, "tree": tree_sha, "parents": [parent] if parent else []}
    commit_sha = json.loads(api(f"/repos/{repo}/git/commits", "POST", commit))["sha"]
    if parent:
        api(f"/repos/{repo}/git/refs/heads/{branch}", "PATCH", {"sha": commit_sha, "force": False})
    else:
        api(f"/repos/{repo}/git/refs", "POST", {"ref": f"refs/heads/{branch}", "sha": commit_sha})
    return commit_sha, parent is None


def logical_size(svg_text):
    """The drawing's own size, from the viewBox. The Excalidraw export writes width and height at
    twice that, so the file says 3580 for a 1790 wide drawing."""
    found = VIEWBOX.search(svg_text)
    if not found:
        raise SystemExit("pr-diagram: the svg has no viewBox, so its scale cannot be read")
    return float(found.group(1)), float(found.group(2))


def normalise_svg(path):
    """Rewrite the svg to 1x: width and height equal to the viewBox. Returns the logical size."""
    text = Path(path).read_text()
    width, height = logical_size(text)
    head, _, rest = text.partition(">")
    head = SIZE_ATTRIBUTE.sub("", head)
    head = head.replace("<svg", f'<svg width="{width:g}" height="{height:g}"', 1)
    Path(path).write_text(head + ">" + rest)
    return width, height


def render_png(svg_path, png_path, width):
    """The png is always the svg at 3x, rendered here rather than exported by hand, so the two can
    never disagree about what the diagram says."""
    if not shutil.which("rsvg-convert"):
        raise SystemExit("pr-diagram: rsvg-convert is not installed (brew install librsvg)")
    done = subprocess.run(["rsvg-convert", "-w", str(int(round(width * PNG_SCALE))),
                           "-o", str(png_path), str(svg_path)], capture_output=True, text=True)
    if done.returncode != 0:
        raise SystemExit(f"pr-diagram: rsvg-convert failed: {done.stderr.strip()[:200]}")


def mean_brightness(png_path):
    """How bright the image looks once it is on a page.

    `-background white -alpha remove -alpha off` is not optional. rsvg-convert writes RGBA, and
    `%[fx:mean]` over an RGBA image averages the alpha channel in with the colour, so a fully opaque
    image reads as (true + 1) / 2. That made a pure black page measure 0.5 and no diagram could pass.
    Flattening onto white also measures what a reader actually sees, so a diagram that looks dark
    only because it is transparent is not mistaken for a dark one."""
    if not shutil.which("magick"):
        return None
    done = subprocess.run(["magick", str(png_path), "-background", "white", "-alpha", "remove",
                           "-alpha", "off", "-colorspace", "Gray", "-format", "%[fx:mean]", "info:"],
                          capture_output=True, text=True)
    try:
        return float(done.stdout.strip())
    except ValueError:
        return None


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--pr", type=int, required=True)
    parser.add_argument("--name", required=True, help="file stem, for example phase-1 or phase-1-updated")
    parser.add_argument("--slug")
    parser.add_argument("--svg", required=True)
    parser.add_argument("--png", help="optional; by default the png is rendered from the svg at 3x")
    parser.add_argument("--alt", help="alt text for the image")
    parser.add_argument("--allow-light", action="store_true", help=argparse.SUPPRESS)
    arguments, unknown = parser.parse_known_args()

    if any(flag.startswith("--source") or flag.startswith("--excalidraw") for flag in unknown):
        raise SystemExit("pr-diagram: the .excalidraw source is not published. Only the png and the svg "
                         "go on the branch. Keep the source in ~/.claude/excalidraw/.")
    if not Path(arguments.svg).is_file():
        raise SystemExit(f"pr-diagram: --svg {arguments.svg} does not exist")

    work = Path(tempfile.mkdtemp(prefix="pr-diagram-"))
    svg_path = work / f"{arguments.name}.svg"
    shutil.copy2(arguments.svg, svg_path)
    width, height = normalise_svg(svg_path)
    png_path = work / f"{arguments.name}.png"
    render_png(svg_path, png_path, width)
    brightness = mean_brightness(png_path)
    print(f"pr-diagram: svg {width:g}x{height:g} at 1x, png at {PNG_SCALE}x "
          f"({int(width * PNG_SCALE)}x{int(height * PNG_SCALE)})"
          + (f", mean brightness {brightness:.3f}" if brightness is not None else ""))
    if brightness is not None and brightness > MAX_MEAN_BRIGHTNESS and not arguments.allow_light:
        raise SystemExit(f"pr-diagram: the diagram is light (mean brightness {brightness:.3f}, the limit is "
                         f"{MAX_MEAN_BRIGHTNESS}). Diagrams are dark. Redraw it on the dark palette in "
                         "~/personal/scripts/gate/diagram-convention.md.")

    repo = repository()
    branch = f"{ASSET_PREFIX}/{arguments.pr}-{arguments.slug or branch_slug()}"
    files = [(f"{arguments.name}.png", str(png_path)), (f"{arguments.name}.svg", str(svg_path))]

    sha, created = publish(repo, branch, files, f"{arguments.name} for pull request #{arguments.pr}")
    print(f"pr-diagram: {'created' if created else 'updated'} {branch} at {sha[:10]}")
    for name, _ in files:
        print(f"  {name}")

    base = f"https://{HOST}/{repo}/blob/{branch}"
    alt = arguments.alt or arguments.name.replace("-", " ")
    print("\n--- paste this into the phase section ---")
    print(f"![{alt}]({base}/{arguments.name}.png?raw=1)")
    print()
    print(f"[svg]({base}/{arguments.name}.svg?raw=1)")


if __name__ == "__main__":
    main()
