    {
      "id": "f1_z1",
      "type": "text",
      "x": 1600,
      "y": 200,
      "width": 462,
      "height": 88,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 14,
      "frameId": null,
      "groupIds": [],
      "index": "a49",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "spec_git_helper.rb:10-12\nbefore(:all) { GitDemoHelper.reset_demo_repositories }\nruns OUTSIDE any example transaction. It seeds the demo\nsolutions and encrypts their variables, so key rows are\nCOMMITTED and survive every rollback. That is a leak.",
      "roughness": 1,
      "roundness": null,
      "seed": 823227980,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "spec_git_helper.rb:10-12\nbefore(:all) { GitDemoHelper.reset_demo_repositories }\nruns OUTSIDE any example transaction. It seeds the demo\nsolutions and encrypts their variables, so key rows are\nCOMMITTED and survive every rollback. That is a leak.",
      "textAlign": "center",
      "updated": 1788682525977,
      "version": 1,
      "versionNonce": 613632200,
      "verticalAlign": "middle"
    },
    {
      "id": "f1_z2",
      "type": "text",
      "x": 1600,
      "y": 340,
      "width": 471,
      "height": 53,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 14,
      "frameId": null,
      "groupIds": [],
      "index": "a50",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "The partition name carries the UTC date:\n\"#{system_partition}_#{Time.now.utc.strftime('%Y%m%d')}\"\nintermediate_key_provider.rb:57-58",
      "roughness": 1,
      "roundness": null,
      "seed": 1406969469,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "The partition name carries the UTC date:\n\"#{system_partition}_#{Time.now.utc.strftime('%Y%m%d')}\"\nintermediate_key_provider.rb:57-58",
      "textAlign": "center",
      "updated": 1788682525977,
      "version": 1,
      "versionNonce": 647432457,
      "verticalAlign": "middle"
    },
    {
      "id": "f1_z3",
      "type": "text",
      "x": 1600,
      "y": 440,
      "width": 496,
      "height": 140,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 14,
      "frameId": null,
      "groupIds": [],
      "index": "a51",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "MAIN today: leaked rows dated TODAY. Step 2's load_latest\nfinds a real committed row, K is real, no phantom.\n\nGATE: leaked rows dated YESTERDAY. Step 2 misses,\nsteps 3 to 8 follow. Same code, same order, different date.\n\nTOMORROW (next UTC day): main behaves like the gate\nuntil something leaks a fresh row.",
      "roughness": 1,
      "roundness": null,
      "seed": 1331955990,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "MAIN today: leaked rows dated TODAY. Step 2's load_latest\nfinds a real committed row, K is real, no phantom.\n\nGATE: leaked rows dated YESTERDAY. Step 2 misses,\nsteps 3 to 8 follow. Same code, same order, different date.\n\nTOMORROW (next UTC day): main behaves like the gate\nuntil something leaks a fresh row.",
      "textAlign": "center",
      "updated": 1788682525977,
      "version": 1,
      "versionNonce": 168200738,
      "verticalAlign": "middle"
    },
    {
      "id": "f1_z4",
      "type": "text",
      "x": 1600,
      "y": 680,
      "width": 479,
      "height": 88,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 14,
      "frameId": null,
      "groupIds": [],
      "index": "a52",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Seed 22 from a pristine database passed this example for\nthe same reason: its before(:all) leak landed same-day.\n\nSo this is not ordering. It is a cache that outlives the\ntransaction, and the calendar decides whether you see it.",
      "roughness": 1,
      "roundness": null,
      "seed": 2081637665,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Seed 22 from a pristine database passed this example for\nthe same reason: its before(:all) leak landed same-day.\n\nSo this is not ordering. It is a cache that outlives the\ntransaction, and the calendar decides whether you see it.",
      "textAlign": "center",
      "updated": 1788682525977,
      "version": 1,
      "versionNonce": 479305029,
      "verticalAlign": "middle"
    },
    {
      "id": "f1_fixtext",
      "type": "text",
      "x": 1600,
      "y": 1550,
      "width": 563,
      "height": 193,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 14,
      "frameId": null,
      "groupIds": [],
      "index": "a53",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "platform/spec/spec_helper.rb:18   config.before(:each) do |example|\nnext to RequestStore.clear! (line 26), add:\n\n    IPaaS::Encryption::SystemKeyProvider.memcache.clear\n    IPaaS::Encryption::IntermediateKeyProvider.memcache.clear\n\nEvery example starts with an empty key cache, so a key that\nonly ever existed in a rolled-back row cannot be reused.\n\nClearing SystemKeyProvider.memcache alone does NOT fix it\n(tested, still 1/18): the phantom lives in the intermediate cache.",
      "roughness": 1,
      "roundness": null,
      "seed": 1689398005,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "platform/spec/spec_helper.rb:18   config.before(:each) do |example|\nnext to RequestStore.clear! (line 26), add:\n\n    IPaaS::Encryption::SystemKeyProvider.memcache.clear\n    IPaaS::Encryption::IntermediateKeyProvider.memcache.clear\n\nEvery example starts with an empty key cache, so a key that\nonly ever existed in a rolled-back row cannot be reused.\n\nClearing SystemKeyProvider.memcache alone does NOT fix it\n(tested, still 1/18): the phantom lives in the intermediate cache.",
      "textAlign": "center",
      "updated": 1788682573064,
      "version": 1,
      "versionNonce": 539774887,
      "verticalAlign": "middle"
    },
    {
