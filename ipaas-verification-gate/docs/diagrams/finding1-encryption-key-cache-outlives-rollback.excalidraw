    {
      "id": "f1_s1-label",
      "type": "text",
      "x": 90,
      "y": 237.5,
      "width": 540,
      "height": 75,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": "f1_s1",
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 14,
      "frameId": null,
      "groupIds": [],
      "index": "a14",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "1. Example A encrypts a secret through its solution\nsolution.encryptor → EncryptorProvider.encryptor_for(uuid, store)\nplatform/app/models/solution.rb:440\nplatform/app/services/encryptor_provider.rb:3-6",
      "roughness": 1,
      "roundness": null,
      "seed": 60555448,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "1. Example A encrypts a secret through its solution\nsolution.encryptor → EncryptorProvider.encryptor_for(uuid, store)\nplatform/app/models/solution.rb:440\nplatform/app/services/encryptor_provider.rb:3-6",
      "textAlign": "center",
      "updated": 1788682525976,
      "version": 1,
      "versionNonce": 505476672,
      "verticalAlign": "middle"
    },
    {
      "id": "f1_s2-label",
      "type": "text",
      "x": 90,
      "y": 437.5,
      "width": 540,
      "height": 75,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": "f1_s2",
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 14,
      "frameId": null,
      "groupIds": [],
      "index": "a16",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "2. encryption_key looks for today's key: cache miss, then DB miss\nmemcache.fetch(partition) runs its block → StoredCryptoKey.load_latest → nil\nintermediate_key_provider.rb:21-23 → stored_crypto_key.rb:25",
      "roughness": 1,
      "roundness": null,
      "seed": 1616741013,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "2. encryption_key looks for today's key: cache miss, then DB miss\nmemcache.fetch(partition) runs its block → StoredCryptoKey.load_latest → nil\nintermediate_key_provider.rb:21-23 → stored_crypto_key.rb:25",
      "textAlign": "center",
      "updated": 1788682525976,
      "version": 1,
      "versionNonce": 1063281097,
      "verticalAlign": "middle"
    },
    {
      "id": "f1_s3-label",
      "type": "text",
      "x": 90,
      "y": 637.5,
      "width": 540,
      "height": 75,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": "f1_s3",
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 14,
      "frameId": null,
      "groupIds": [],
      "index": "a18",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "3. So it creates key K and writes it\ncreate_new_intermediate_key → StoredCryptoKey.create_latest → store.write\nintermediate_key_provider.rb:27,67 → stored_crypto_key.rb:22,30\n→ solution_store.rb:30-31 (SolutionStoreEntry INSERT)",
      "roughness": 1,
      "roundness": null,
      "seed": 1490334010,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "3. So it creates key K and writes it\ncreate_new_intermediate_key → StoredCryptoKey.create_latest → store.write\nintermediate_key_provider.rb:27,67 → stored_crypto_key.rb:22,30\n→ solution_store.rb:30-31 (SolutionStoreEntry INSERT)",
      "textAlign": "center",
      "updated": 1788682525976,
      "version": 1,
      "versionNonce": 984447122,
      "verticalAlign": "middle"
    },
    {
      "id": "f1_s4-label",
      "type": "text",
      "x": 90,
      "y": 837.5,
      "width": 540,
      "height": 75,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": "f1_s4",
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 14,
      "frameId": null,
      "groupIds": [],
      "index": "a20",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "4. Example A ends. RSpec rolls the transaction back.\nconfig.use_transactional_fixtures = true\nplatform/spec/rails_helper.rb:31",
      "roughness": 1,
      "roundness": null,
      "seed": 1790623221,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "4. Example A ends. RSpec rolls the transaction back.\nconfig.use_transactional_fixtures = true\nplatform/spec/rails_helper.rb:31",
      "textAlign": "center",
