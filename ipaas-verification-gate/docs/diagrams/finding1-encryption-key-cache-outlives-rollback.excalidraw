      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "7. The cloner copies the secret and must decrypt it\ndecryption_key(K.id): memcache.fetch(id) misses, the cache is keyed by\npartition, not by id · intermediate_key_provider.rb:34-36\n→ StoredCryptoKey.load(store, id) → solution_store.rb:24-25",
      "roughness": 1,
      "roundness": null,
      "seed": 79741060,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "7. The cloner copies the secret and must decrypt it\ndecryption_key(K.id): memcache.fetch(id) misses, the cache is keyed by\npartition, not by id · intermediate_key_provider.rb:34-36\n→ StoredCryptoKey.load(store, id) → solution_store.rb:24-25",
      "textAlign": "center",
      "updated": 1788682525976,
      "version": 1,
      "versionNonce": 395606174,
      "verticalAlign": "middle"
    },
