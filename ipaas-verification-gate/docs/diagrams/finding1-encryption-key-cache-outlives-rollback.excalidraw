      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "6. encryption_key: cache HIT hands back the phantom K\nmemcache.fetch(partition) returns K; load_latest never runs\nintermediate_key_provider.rb:22\nthe ciphertext now carries K's identifier",
      "roughness": 1,
      "roundness": null,
      "seed": 1026322991,
      "strokeColor": "#e8590c",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "6. encryption_key: cache HIT hands back the phantom K\nmemcache.fetch(partition) returns K; load_latest never runs\nintermediate_key_provider.rb:22\nthe ciphertext now carries K's identifier",
      "textAlign": "center",
      "updated": 1788682525976,
      "version": 1,
      "versionNonce": 216963669,
      "verticalAlign": "middle"
    },
    {
      "id": "f1_s7-label",
      "type": "text",
