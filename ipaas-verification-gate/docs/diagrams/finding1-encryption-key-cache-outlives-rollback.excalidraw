      "originalText": "5. Example B encrypts with the source solution\nencrypted_blob = source_solution.encryptor.encrypt('super-secret-plaintext')\nspec/unit/services/runbook_cloner_spec.rb:403",
      "roughness": 1,
      "roundness": null,
